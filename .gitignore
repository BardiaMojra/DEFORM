# local Python env -- never commit, huge (bundles CUDA/torch shared libraries,
# multi-hundred-MB to 1GB+ individual files that exceed GitHub's own 100MB hard limit)
.venv/
__pycache__/
*.pyc

# raw per-episode training/eval data AND trained checkpoints -- both kept offline
# only now (policy update: previously save_model/ was the one thing committed as
# "the final results", but per-episode data grows with every new dlo_traj_tag
# trained on this project's own dataset, and checkpoints are cheap to regenerate --
# neither belongs in git). data_set/*/dlo_type_config.json (small per-tag metadata,
# not per-episode data) is still tracked.
data_set/*/train/
data_set/*/eval/
save_model/
loss_record/
