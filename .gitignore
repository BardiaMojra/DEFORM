# local Python env -- never commit, huge (bundles CUDA/torch shared libraries,
# multi-hundred-MB to 1GB+ individual files that exceed GitHub's own 100MB hard limit)
.venv/
__pycache__/
*.pyc

# raw per-episode training/eval data -- kept offline only (large, grows with every
# new dlo_traj_tag calibrated/trained on this project's own dataset). What DOES get
# committed: save_model/ (trained weights) and data_set/*/dlo_type_config.json (the
# small per-tag metadata needed to load a checkpoint) -- "post the final results, not
# the underlying data" per project convention.
data_set/*/train/
data_set/*/eval/
